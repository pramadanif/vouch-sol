# =============================================
# Vouch Frontend Environment Variables (Solana)
# =============================================
# Copy this file to .env.local and fill in the values

# Backend API URL
# Development:
NEXT_PUBLIC_API_URL=http://localhost:3002

# Production (sesuaikan dengan domain Anda):
# NEXT_PUBLIC_API_URL=https://vouch.pramadani.site

# Solana Admin Public Key (untuk admin page)
NEXT_PUBLIC_ADMIN_PUBKEY=YOUR_ADMIN_PUBKEY_HERE
