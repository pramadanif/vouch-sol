# =============================================
# Vouch Backend Environment Variables (Solana)
# =============================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vouch"

# Server
PORT=3002
NODE_ENV=development

# Solana Configuration
SOLANA_RPC_URL=http://localhost:8899
SOLANA_PROGRAM_ID=YOUR_PROGRAM_ID_HERE
SOLANA_USDC_MINT=EPjFWaLb3jqZzpEiwKN7jqvFo8wjRgdq6P1vGHdkDVTe
SOLANA_IDRX_MINT=YOUR_IDRX_MINT_HERE
SOLANA_KEYPAIR_PATH=./keypair.json
SOLANA_FEE_BPS=100

# Xendit Payment Gateway (for fiat → crypto on-ramp)
XENDIT_SECRET_KEY=YOUR_XENDIT_SECRET_KEY
XENDIT_CALLBACK_TOKEN=YOUR_XENDIT_CALLBACK_TOKEN

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000
